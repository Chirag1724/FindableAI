# ==============================================================================
# FindableAI Environment Variables
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=info

# Explicit opt-in for non-production synthetic demo fill (default false).
# Normal scans never inject fabricated intents/scores/patches unless this is true.
# Demo output is never remediation-eligible.
ALLOW_SYNTHETIC_DEMO=false

# Database (PostgreSQL + pgvector)
POSTGRES_USER=findable
POSTGRES_PASSWORD=findable_secret
POSTGRES_DB=findable_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://findable:findable_secret@localhost:5432/findable_db

# Optional: disposable PostgreSQL+pgvector URL for integration tests only.
# Prefer loopback. Never point this at production.
# FINDABLE_PG_INTEGRATION=1
# FINDABLE_PG_DATABASE_URL=postgresql+asyncpg://findable:findable_secret@127.0.0.1:55432/findable_itest
# FINDABLE_PG_ALLOW_REMOTE=0

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Cache & Message Broker (Redis)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# LLM Providers & Configurable Models (Primary & Fallback)
GROQ_API_KEY=gsk_your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Primary & Fallback Models
DEFAULT_LLM_MODEL=gemini/gemini-2.5-flash
FALLBACK_LLM_MODEL=groq/openai/gpt-oss-120b

# Provider Model Defaults
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-3.6-flash
OPENAI_MODEL=gpt-4o-mini

# GitHub Integration (Autonomous PR Engine)
# Required scope: Personal Access Token (PAT) with 'repo' scope (or 'public_repo' for public repositories)
GITHUB_TOKEN=your_personal_access_token_here

# Security & Authentication
# Required when ENVIRONMENT=production (startup/readiness fail closed if empty).
# In development/test, empty API_KEY intentionally allows open local access.
# When set, enforces X-API-Key or Bearer token on protected endpoints.
API_KEY=

# In-Memory Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_SCANS_PER_MINUTE=10

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Scanner Defaults & Safeguards
MAX_SCAN_PAGES=15
SCAN_TIMEOUT_SECONDS=60
LLM_BUDGET_CAP_USD=0.01
# Estimated USD per reserved provider call (not provider invoices).
LLM_ESTIMATED_USD_PER_CALL=0.0001
# When true, BudgetGuard hard-stops on estimated USD >= LLM_BUDGET_CAP_USD.
LLM_ENFORCE_USD_BUDGET=true
MAX_LLM_CALLS_PER_SCAN=60

# Durable scan jobs (PostgreSQL-backed queue; no separate broker)
DURABLE_SCAN_JOBS=true
# After enqueue, also claim in-process via BackgroundTasks (local/dev/test only).
# Default in code is false (production-safe). Set true locally/CI; keep false in
# Compose production and run: python -m app.worker
SCAN_JOB_INLINE_FALLBACK=true
SCAN_JOB_MAX_ATTEMPTS=3
SCAN_JOB_LEASE_SECONDS=600
SCAN_JOB_POLL_INTERVAL_SECONDS=2
SCAN_JOB_BACKOFF_BASE_SECONDS=5
SCAN_JOB_BACKOFF_MAX_SECONDS=300
SCAN_JOB_EXECUTION_DEADLINE_SECONDS=3600
SCAN_JOB_IDEMPOTENCY_TTL_SECONDS=86400
# Optional stable worker identity (defaults to hostname:pid:random)
SCAN_WORKER_ID=

# LLM provider resilience
LLM_CONNECT_TIMEOUT_SECONDS=10
LLM_REQUEST_TIMEOUT_SECONDS=90
LLM_PROVIDER_MAX_ATTEMPTS=4
LLM_GLOBAL_CONCURRENCY=8

# Frontend Service Configuration
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
