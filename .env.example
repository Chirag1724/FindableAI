# ==============================================================================
# FindableAI Environment Variables
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=info

# Database (PostgreSQL + pgvector)
POSTGRES_USER=findable
POSTGRES_PASSWORD=findable_secret
POSTGRES_DB=findable_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://findable:findable_secret@localhost:5432/findable_db

# Cache & Message Broker (Redis)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Primary LLM Provider (Groq LPUs + Qwen 2.5)
GROQ_API_KEY=gsk_your_groq_api_key_here
DEFAULT_LLM_MODEL=groq/qwen-2.5-72b-instruct

# Secondary / Fallback Providers (Optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# GitHub Integration (Autonomous PR Engine)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_TOKEN=your_personal_access_token_or_app_token

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Scanner Defaults
MAX_SCAN_PAGES=15
SCAN_TIMEOUT_SECONDS=60
LLM_BUDGET_CAP_USD=0.01
MAX_LLM_CALLS_PER_SCAN=35
