# ==============================================================================
# FindableAI Environment Variables
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=info

# Explicit opt-in for non-production synthetic demo fill (default false).
# Normal scans never inject fabricated intents/scores/patches unless this is true.
# Demo output is never remediation-eligible.
ALLOW_SYNTHETIC_DEMO=false

# Database (PostgreSQL + pgvector)
POSTGRES_USER=findable
POSTGRES_PASSWORD=findable_secret
POSTGRES_DB=findable_db
# Host port published by docker compose. Use 55432 if 5432 is already taken.
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://findable:findable_secret@localhost:5432/findable_db

# Optional: disposable PostgreSQL+pgvector URL for integration tests only.
# Prefer loopback. Never point this at production.
# FINDABLE_PG_INTEGRATION=1
# FINDABLE_PG_DATABASE_URL=postgresql+asyncpg://findable:findable_secret@127.0.0.1:55432/findable_itest
# FINDABLE_PG_ALLOW_REMOTE=0

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Cache & Message Broker (Redis)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# LLM Providers — each provider uses ONLY its own key (never cross-wired).
# A key whose prefix belongs to another issuer is rejected for this provider
# (e.g. an xai- key in GROQ_API_KEY is not sent to Groq). Run:
#   cd backend && python scripts/check_providers.py
# Keys are never logged. Fill the providers you actually have; leave others empty.
GROQ_API_KEY=gsk_your_groq_api_key_here
# Optional: Multiple Groq keys for automatic round-robin rotation, 24k+ TPM headroom, and 0s 429 failover.
GROQ_API_KEYS=gsk_key1,gsk_key2,gsk_key3
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=sk-your_openai_api_key_here
OPENROUTER_API_KEY=sk-or-your_openrouter_api_key_here
NVIDIA_API_KEY=nvapi-your_nvidia_api_key_here
# Anthropic is reserved (no endpoint in this codebase); leave empty.
ANTHROPIC_API_KEY=

# Primary & Fallback Models (Groq LPU verified)
DEFAULT_LLM_MODEL=groq/openai/gpt-oss-120b
FALLBACK_LLM_MODEL=groq/qwen/qwen3.8-27b

# Tiered models used by the scan pipeline (heavy = intents/contradictions, fast = NLI)
HEAVY_LLM_MODEL=groq/openai/gpt-oss-120b
FAST_LLM_MODEL=groq/qwen/qwen3.8-27b

# Provider Model Defaults
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-4o-mini

# GitHub Integration (Autonomous PR Engine) — OPTIONAL for read-only scans.
# Omit GITHUB_TOKEN (or leave empty) for the ordinary smoke test: scans never open a PR
# unless a remediation/apply endpoint is explicitly invoked with a connected repo_url.
# Required scope when used: Personal Access Token (PAT) with 'repo' scope (or 'public_repo').
GITHUB_TOKEN=

# Security & Authentication
# Required when ENVIRONMENT=production (startup/readiness fail closed if empty).
# Compose passes API_KEY through; empty is OK for `docker compose up -d postgres`.
# Starting backend/worker with ENVIRONMENT=production still refuses an empty key.
# In development/test, empty API_KEY intentionally allows open local access.
# When set, enforces X-API-Key or Bearer token on protected endpoints.
API_KEY=

# In-Memory Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_SCANS_PER_MINUTE=10

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Scanner Defaults & Safeguards
MAX_SCAN_PAGES=15
SCAN_TIMEOUT_SECONDS=60
LLM_BUDGET_CAP_USD=0.01
# Estimated USD per reserved provider call (not provider invoices).
LLM_ESTIMATED_USD_PER_CALL=0.0001
# When true, BudgetGuard hard-stops on estimated USD >= LLM_BUDGET_CAP_USD.
LLM_ENFORCE_USD_BUDGET=true
# Hard cap on outbound provider attempts per scan (retries/splits/failovers each
# count once). Do not raise this to hide retry amplification — fix the algorithm.
# Normal path: 3 PLAN (persona) + 3 ACT batches + <=6 VERIFY = 6–12 requests.
MAX_LLM_CALLS_PER_SCAN=35

# Evaluation (ACT) batching: 30 intents -> 3 batches of 10, one persona per batch.
EVAL_BATCH_SIZE=10
EVAL_BATCH_CONCURRENCY=3
EVAL_BATCH_RETRIES=1
EVAL_SPLIT_MIN_BATCH=5
EVAL_MAX_RECOVERY_REQUESTS_PER_BATCH=6
EVAL_TOP_K=3
# VERIFY stage: max semantic contradiction LLM calls per scan.
MAX_SEMANTIC_CONTRADICTION_CALLS=6

# Groq free-tier pacing (estimated tokens = prompt/4 + max_tokens). 0 = off.
GROQ_RPM_LIMIT=28
GROQ_TPM_LIMIT=8000

# Query-time retrieval (ACT): dense + lexical fused by RRF
RETRIEVAL_DENSE_K=10
RETRIEVAL_LEXICAL_K=10
RETRIEVAL_RRF_K=60
RETRIEVAL_TOP_K=5

# Cache-only remediation: max age of durable evidence (seconds). Default 7 days.
# Stale evidence is rejected with reason stale_evidence (never silently reused).
EVIDENCE_TTL_SECONDS=604800

# Durable scan jobs (PostgreSQL-backed queue; no separate broker)
DURABLE_SCAN_JOBS=true
# Degrade /ready when a queued job is older than this (seconds) with no worker heartbeat.
SCAN_JOB_QUEUE_STALE_SECONDS=120
# After enqueue, also claim in-process via BackgroundTasks. Default false so the
# API never silently depends on itself for execution. Run API+worker together:
#   python scripts/run_local.py
# or in a second terminal: python -m app.worker
SCAN_JOB_INLINE_FALLBACK=false
SCAN_JOB_MAX_ATTEMPTS=3
SCAN_JOB_LEASE_SECONDS=600
SCAN_JOB_POLL_INTERVAL_SECONDS=2
SCAN_JOB_BACKOFF_BASE_SECONDS=5
SCAN_JOB_BACKOFF_MAX_SECONDS=300
SCAN_JOB_EXECUTION_DEADLINE_SECONDS=3600
SCAN_JOB_IDEMPOTENCY_TTL_SECONDS=86400
# Optional stable worker identity (defaults to hostname:pid:random)
SCAN_WORKER_ID=

# LLM provider resilience
LLM_CONNECT_TIMEOUT_SECONDS=10
LLM_REQUEST_TIMEOUT_SECONDS=90
LLM_PROVIDER_MAX_ATTEMPTS=4
LLM_GLOBAL_CONCURRENCY=8

# Frontend Service Configuration
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional browser API key for authenticated fetch/SSE (required when API_KEY is set).
# Prefer an org-scoped key; never commit real secrets.
NEXT_PUBLIC_FINDABLE_API_KEY=

